<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tasty Kitchen</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #fffaf3;
            color: #333;
        }

        header {
            background-color: #e85d3f;
            color: white;
            padding: 20px;
            text-align: center;
        }

        header h1 {
            font-size: 32px;
        }

        nav {
            background-color: #333;
            padding: 15px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 12px;
            font-size: 16px;
        }

        .hero {
            text-align: center;
            padding: 60px 20px;
            background-color: #ffe3c2;
        }

        .hero h2 {
            font-size: 32px;
            color: #b83d25;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 18px;
            margin-bottom: 20px;
        }

        .hero button {
            background-color: #e85d3f;
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 25px;
            font-size: 16px;
            cursor: pointer;
            transition: 0.3s;
        }

        .hero button:hover {
            background-color: #333;
            transform: scale(1.05);
        }

        .recipes {
            padding: 35px 20px;
            text-align: center;
        }

        .recipes h2 {
            color: #b83d25;
            margin-bottom: 25px;
        }

        .recipe-container {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .card {
            background-color: white;
            width: 280px;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 3px 10px #ccc;
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }

        .card h3 {
            color: #e85d3f;
            margin: 15px;
        }

        .card p {
            padding: 0 15px 20px;
        }

        footer {
            background-color: #333;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 30px;
        }

        @media (max-width: 600px) {
            nav a {
                display: inline-block;
                margin: 7px;
            }

            .hero h2 {
                font-size: 25px;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>🍳 Tasty Kitchen</h1>
        <p>Delicious Recipes for Everyone!</p>
    </header>

    <nav>
        <a href="#home">Home</a>
        <a href="#recipes">Recipes</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
    </nav>

    <section class="hero" id="home">
        <h2>Welcome to Tasty Kitchen!</h2>
        <p>Discover delicious recipes and enjoy cooking.</p>
        <button onclick="document.getElementById('recipes').scrollIntoView()">
            Explore Recipes
        </button>
    </section>

    <section class="recipes" id="recipes">
        <h2>Our Popular Recipes</h2>

        <div class="recipe-container">

            <div class="card">
                <img src="https://images.unsplash.com/photo-1513104890138-7c749659a591?w=600" alt="Pizza">
                 <h3>Cheese Pizza</h3>
                 <p>A delicious homemade pizza with cheese and vegetables.</p>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1621996346565-e3dbc646d9a9?w=600" alt="Pasta">
                <h3>Italian Pasta</h3>
                <p>Creamy and tasty pasta for your lunch or dinner.</p>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=600" alt="Cake">
                <h3>Chocolate Cake</h3>
                <p>A sweet chocolate dessert for special moments.</p>
            </div>

        </div>
    </section>

    <footer id="contact">
        <p>© 2026 Tasty Kitchen | Made with Love ❤️</p>
    </footer>

</body>
</html>
